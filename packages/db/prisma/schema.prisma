generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is what Vercel's serverless runtime needs.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Identity
// ──────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  firebaseUid   String    @unique
  email         String    @unique
  displayName   String?
  photoUrl      String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  isDisabled    Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cartItems     CartItem[]
  orders        Order[]
  orderEvents   OrderStatusEvent[]
  reviews       Review[]           @relation("ReviewAuthor")
  hiddenReviews Review[]           @relation("ReviewModerator")

  @@index([role])
}

// ──────────────────────────────────────────────
// Catalog
// ──────────────────────────────────────────────

/// Two-level tree: a root category (Pipe Cleaner, Crochet) with subcategories.
model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")

  slug        String     @unique
  name        String
  description String?
  imageUrl    String?
  /// Manual ordering within the parent; admins reorder by rewriting this.
  position    Int        @default(0)
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]

  @@index([parentId, position])
  @@index([isArchived])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FulfillmentType {
  READY_STOCK
  MADE_TO_ORDER
}

model Product {
  id              String          @id @default(uuid()) @db.Uuid
  slug            String          @unique
  name            String
  description     String?         @db.Text
  shortDescription String?        @db.VarChar(300)

  categoryId      String          @db.Uuid
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  status          ProductStatus   @default(DRAFT)
  fulfillmentType FulfillmentType @default(READY_STOCK)

  /// Estimated production days for made-to-order items.
  productionDays  Int?

  /// SEO fields
  metaTitle       String?         @db.VarChar(70)
  metaDescription String?         @db.VarChar(160)

  /// Position within category for manual ordering.
  position        Int             @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  /// Denormalised rating aggregates over PUBLISHED reviews only.
  reviewCount     Int             @default(0)
  ratingSum       Int             @default(0)

  variants        ProductVariant[]
  images          ProductImage[]
  reviews         Review[]

  @@index([categoryId, position])
  @@index([status])
  @@index([slug])
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @db.Uuid
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Display label, e.g. "Small / Red" or "Default" for single-variant products.
  label          String   @default("Default")
  sku            String   @unique

  /// Price in integer paise (1 INR = 100 paise). Never a float.
  priceInPaise   Int
  /// Optional compare-at / MRP price for showing discounts.
  compareAtPriceInPaise Int?

  /// Current stock quantity. Null means unlimited (made-to-order).
  stockQuantity  Int?
  /// Minimum stock level before triggering low-stock alerts.
  lowStockThreshold Int   @default(5)

  /// Variant ordering within the product.
  position       Int      @default(0)
  isAvailable    Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId, position])
  @@index([isAvailable])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Cloudinary (or other CDN) URL. The upload integration lands in a later phase.
  url        String
  altText    String?
  /// Display order; 0 = hero image.
  position   Int      @default(0)

  createdAt  DateTime @default(now())

  @@index([productId, position])
}

// ──────────────────────────────────────────────
// Cart
// ──────────────────────────────────────────────

/// One line per user per variant. Prices are never stored here; they are read
/// live from the variant so the cart can't carry stale or client-supplied prices.
model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, variantId])
  @@index([variantId])
}

// ──────────────────────────────────────────────
// Orders & payments
// ──────────────────────────────────────────────

enum OrderStatus {
  /// Stock reserved; waiting for a verified Razorpay payment.
  PENDING_PAYMENT
  PAID
  /// Customer abandoned checkout; stock released.
  CANCELLED
  /// Not paid within the reservation window; stock released.
  EXPIRED
}

enum PaymentStatus {
  AUTHORIZED
  CAPTURED
  FAILED
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING_PAYMENT)

  customerName    String
  email           String
  phone           String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  postalCode      String
  country         String      @default("IN")

  /// All amounts in integer paise, computed on the server.
  subtotalInPaise Int
  shippingInPaise Int
  totalInPaise    Int
  currency        String      @default("INR")

  razorpayOrderId String?     @unique
  /// Stock reservation ends here; unpaid orders past this are expired.
  expiresAt       DateTime
  paidAt          DateTime?
  cancelledAt     DateTime?
  /// Set when something needs a human (e.g. paid after stock was released).
  requiresReview  Boolean     @default(false)
  reviewReason    String?

  /// Set to CONFIRMED when payment is verified; staff move it forward from there.
  fulfillmentStatus    FulfillmentStatus?
  shippingCarrier      String?
  trackingNumber       String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  fulfillmentCancelledAt DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  payments        Payment[]
  events          OrderStatusEvent[]
  notifications   EmailNotification[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([fulfillmentStatus])
}

/// Snapshot of what was bought; never changes when the catalog does.
model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @db.Uuid
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?         @db.Uuid
  variantId        String?         @db.Uuid
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName      String
  productSlug      String
  variantLabel     String
  sku              String
  unitPriceInPaise Int
  quantity         Int
  lineTotalInPaise Int
  fulfillmentType  FulfillmentType
  productionDays   Int?
  /// True when stock was decremented for this line (tracked-stock variants only).
  stockReserved    Boolean

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayPaymentId String        @unique
  status            PaymentStatus
  amountInPaise     Int
  method            String?
  errorCode         String?
  errorDescription  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

/// Razorpay webhook event IDs already processed, for duplicate-delivery safety.
model WebhookEvent {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())
}

enum FulfillmentStatus {
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Audit trail of fulfillment changes. actorId null = system (e.g. payment confirmation).
model OrderStatusEvent {
  id         String             @id @default(uuid()) @db.Uuid
  orderId    String             @db.Uuid
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus FulfillmentStatus?
  toStatus   FulfillmentStatus
  actorId    String?            @db.Uuid
  actor      User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime           @default(now())

  @@index([orderId, createdAt])
}

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_FAILED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// One email per order per type; the unique key makes duplicate sends impossible.
model EmailNotification {
  id           String             @id @default(uuid()) @db.Uuid
  orderId      String             @db.Uuid
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type         NotificationType
  status       NotificationStatus @default(PENDING)
  recipient    String
  attempts     Int                @default(0)
  lastError    String?
  providerId   String?
  sentAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([orderId, type])
  @@index([status])
}

// ──────────────────────────────────────────────
// Reviews
// ──────────────────────────────────────────────

enum ReviewStatus {
  PUBLISHED
  /// Hidden by staff (abuse, spam). Excluded from the storefront and aggregates.
  HIDDEN
}

/// Only verified buyers can review, and only once per product.
model Review {
  id           String       @id @default(uuid()) @db.Uuid
  productId    String       @db.Uuid
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String       @db.Uuid
  user         User         @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)

  rating       Int
  title        String?      @db.VarChar(120)
  body         String?      @db.VarChar(2000)

  status       ReviewStatus @default(PUBLISHED)
  hiddenReason String?      @db.VarChar(300)
  hiddenAt     DateTime?
  hiddenById   String?      @db.Uuid
  hiddenBy     User?        @relation("ReviewModerator", fields: [hiddenById], references: [id], onDelete: SetNull)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}
