{
  "name": "susharts",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm build:libs && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:libs && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm build:libs && pnpm -r test",
    "db:generate": "pnpm --filter @susharts/db generate",
    "db:migrate": "pnpm --filter @susharts/db migrate",
    "build:libs": "pnpm --filter \"./packages/*\" build",
    "vercel-build": "pnpm --filter @susharts/db generate && pnpm build:libs && pnpm --filter @susharts/api build && pnpm --filter @susharts/web build"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0"
  }
}
