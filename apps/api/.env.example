# Required now (Phase 1)
NODE_ENV=development
PORT=4000
# Supabase Session Pooler (port 5432). Port 6543 (transaction pooler) must not
# be used here: prisma migrate needs session-level advisory locks.
# Serverless note: on Vercel use Supabase's Transaction pooler (port 6543) with
# ?pgbouncer=true&connection_limit=1 appended. Keep port 5432 for running migrations.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=20"
# In production set this to your site URL, e.g. https://susharts.vercel.app
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Required (Phase 3). Download a service-account key from
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key.
# Copy project_id, client_email, and private_key from the JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM key as one line; literal \n is fine — the server unescapes them.
FIREBASE_PRIVATE_KEY=\n

# Phase 5 — product images. Cloudinary Console → Settings → API Keys.
# Optional at boot; image upload/delete endpoints return 503 until all three are set.
# The API secret is server-only: never add it to apps/web.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Phase 7 — payments. Razorpay Dashboard → Account & Settings → API Keys
# (use Test Mode keys locally). The key id is sent to the browser for the
# checkout modal; the key secret and webhook secret never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → the secret you choose when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=


# Phase 8 — order emails via Resend (resend.com → API Keys). Server only.
# EMAIL_FROM must use a domain verified in Resend, e.g. "Susharts <orders@yourdomain.com>".
# Optional at boot; emails are recorded as FAILED and can be retried from the admin panel.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Storefront URL for links in emails (defaults to the first CORS origin).
PUBLIC_WEB_URL=
